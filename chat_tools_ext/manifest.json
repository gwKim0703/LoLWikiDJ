{
  "manifest_version": 3,
  "name": "롤디칩",
  "version": "1.2.1",
  "description": "롤디 전용 확장 프로그램입니다",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "http://lolwiki.kr/*",
    "https://lolwiki.kr/*",
    "https://*.lolwiki.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["default.png"],
      "matches": [
        "https://www.lolwiki.xyz/*",
        "https://lolwiki.xyz/*",
        "https://*.lolwiki.xyz/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.lolwiki.xyz/*",
        "https://lolwiki.xyz/*",
        "https://*.lolwiki.xyz/*"
      ],
      "js": [
        "page_bridge.js",
        "lol_board_bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.lolwiki.xyz/*",
        "https://lolwiki.xyz/*",
        "https://*.lolwiki.xyz/*"
      ],
      "js": [
        "content.js",
        "lol_board_relay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}